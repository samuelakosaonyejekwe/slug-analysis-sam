__pycache__/
*.pyc
*.pyo
.venv/
venv/
~$*
case/scripts/_report_plots/
case/scripts/_anim_cache/
#  build_report.py stages its word-per-minute figure copies here and does not
#  always clear them; they are regenerated on every build.
case/_tmp_wpm/
report.docx

# figures regenerated without chart titles for the journal manuscript, which is
# deliberately not kept in this repo; reproduce with case/scripts/make_paper_figures.py
case/outputs_paper_*/
# slide-legible figure sets: the same outputs re-rendered at SHCT_FIG_FONTSCALE=1.8 for
# projection, built only to compose the deck (which is not in this repo). Derived from
# the tracked outputs, so rebuild with case/scripts/make_slide_figures.py rather than
# storing a second copy of every figure.
case/outputs_slides*/
#  another derived slide-figure set found on disk (wide layout, 286 dpi).
#  Nothing in this repo generates that name, so it is excluded rather than
#  committed — it is a rendering of tracked outputs either way.
case/outputs_deck*/
case/outputs_slides_*/

# the assembled manuscript figure set (Figure_1..N.png); a pure derivative of the
# outputs above, rebuilt with case/scripts/export_paper_figures.py
case/figures_paper/

# build artefacts of case/scripts/build_reports.py and build_report.py — regenerated
# from the solver outputs on every run, like report.docx above
case/scripts/case_study.docx
case/scripts/model.equations.docx
case/scripts/report_plots/
